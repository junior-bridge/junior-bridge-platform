SECRET_KEY=replace_with_your_secret_key
POSTGRES_DB=junior_bridge
POSTGRES_USER=junior_bridge
POSTGRES_PASSWORD=replace_with_your_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
FRONTEND_OAUTH_SUCCESS_URL=http://localhost:3000/dashboard
FRONTEND_OAUTH_ERROR_URL=http://localhost:3000/login
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TIMEOUT=3600
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
API_BASE=http://localhost:8000/api
NEXT_PUBLIC_API_BASE=http://localhost:8000
MONGODB_URI=
MONGODB_DATABASE=junior_bridge

# AWS para subir las fotos (S3)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Email (SMTP). Con EMAIL_HOST vacío, el email usa el backend de consola.
# Desarrollo (Mailtrap sandbox, no entrega a casillas reales):
#   EMAIL_HOST=sandbox.smtp.mailtrap.io
#   EMAIL_PORT=2525
#   EMAIL_HOST_USER=<usuario de Mailtrap>
#   EMAIL_HOST_PASSWORD=<password de Mailtrap>
# Producción (Gmail SMTP, entrega a casillas reales; solo en el servidor de producción):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=<cuenta de Gmail del proyecto>
#   EMAIL_HOST_PASSWORD=<contraseña de aplicación de Google>
#   DEFAULT_FROM_EMAIL=<la misma cuenta de Gmail>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@juniorbridge.com
EMAIL_TIMEOUT=10

# PageSpeed Insights. La API key es opcional (sin ella la cuota es menor).
PAGESPEED_API_KEY=
PAGESPEED_TIMEOUT=120

# Redis para WebSockets y notificaciones
REDIS_URL=redis://redis:6379/0

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001


SEED_TEST_USERS=false

# Cookies Secure. Dejar en true (produccion/HTTPS). Poner false solo en local para clientes HTTP como Newman.
AUTH_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
